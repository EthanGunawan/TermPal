<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TermPal.AddCoursePage"
             Title="Add Course">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Course Code -->
            <Label Text="Course Code"
                   FontSize="16"
                   FontAttributes="Bold" />
            <Entry x:Name="CourseCodeEntry"
                   Placeholder="e.g., PROG 1004"
                   FontSize="16" />

            <!-- Course Title -->
            <Label Text="Course Title"
                   FontSize="16"
                   FontAttributes="Bold" />
            <Entry x:Name="TitleEntry"
                   Placeholder="e.g., Programming Languages"
                   FontSize="16" />

            <!-- Room -->
            <Label Text="Room Number"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
            <Entry x:Name="RoomEntry"
                   Placeholder="e.g., BC123 or VTL for virtual"
                   FontSize="16" />

            <!-- Professor -->
            <Label Text="Professor"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
            <Entry x:Name="ProfessorEntry"
                   Placeholder="e.g., Dr. Smith"
                   FontSize="16" />

            <!-- Days -->
            <Label Text="Days"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
            <Entry x:Name="DaysEntry"
                   Placeholder="e.g., Monday, Wednesday"
                   FontSize="16" />

            <!-- Start Time -->
            <Label Text="Start Time"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
            <TimePicker x:Name="StartTimePicker"
                        Format="t"
                        Margin="0,5,0,0" />

            <!-- End Time -->
            <Label Text="End Time"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,10,0,0" />
            <TimePicker x:Name="EndTimePicker"
                        Format="t"
                        Margin="0,5,0,0" />

            <!-- Buttons -->
            <HorizontalStackLayout Spacing="10"
                                   HorizontalOptions="Center"
                                   Margin="0,20,0,0">
                <Button x:Name="CancelButton"
                        Text="Cancel"
                        Clicked="OnCancelButtonClicked"
                        BackgroundColor="#808080"
                        TextColor="White"
                        FontSize="16"
                        Padding="20,10"
                        CornerRadius="8" />
                <Button x:Name="SaveCourseButton"
                        Text="Save Course"
                        Clicked="OnSaveCourseButtonClicked"
                        BackgroundColor="#4A90E2"
                        TextColor="White"
                        FontSize="16"
                        Padding="20,10"
                        CornerRadius="8" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>