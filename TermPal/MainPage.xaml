<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TermPal.MainPage"
             Title="TermPal">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Header -->
        <Label Grid.Row="0"
               Text="My Semesters"
               FontSize="32"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,20,0,10" />

        <!-- Terms CollectionView -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Terms}"
                        SelectionMode="Single"
                        x:Name="TermsCollectionView"
                        SelectionChanged="TermsCollectionView_SelectionChanged"
                        Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <!-- Swipe from left: Edit term -->
                        <SwipeView.LeftItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Edit"
                                           BackgroundColor="DodgerBlue"
                                           Invoked="OnEditTermSwipeInvoked" />
                            </SwipeItems>
                        </SwipeView.LeftItems>

                        <!-- Swipe from right: Delete term -->
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Delete"
                                           BackgroundColor="IndianRed"
                                           Invoked="OnDeleteTermSwipeInvoked" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <!-- Main content (tap = open TermDetailsPage) -->
                        <Border Margin="10"
                                Padding="20"
                                StrokeThickness="0"
                                BackgroundColor="#F5F5F5">
                            <Label Text="{Binding Title}"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Add Term Button -->
        <Button Grid.Row="2"
                x:Name="AddTermButton"
                Text="+ Add Semester"
                Clicked="OnAddTermButtonClicked"
                BackgroundColor="#4A90E2"
                TextColor="White"
                FontSize="18"
                Padding="15"
                Margin="10"
                CornerRadius="8"
                HorizontalOptions="Center" />
    </Grid>

</ContentPage>