<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TermPal.TermDetailsPage"
             Title="Term Details">

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <!-- Term Title -->
        <Label Grid.Row="0"
               x:Name="TermTitleLabel"
               Text="Semester Title"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,20,0,10" />

        <!-- Courses Header -->
        <Label Grid.Row="1"
               Text="Courses"
               FontSize="18"
               FontAttributes="Bold"
               Margin="10,0,0,10" />

        <!-- Courses CollectionView -->
        <CollectionView Grid.Row="2"
                        x:Name="CoursesCollectionView"
                        Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="10"
                            Padding="15"
                            StrokeThickness="0"
                            BackgroundColor="#F5F5F5">
                        <VerticalStackLayout Spacing="3">
                            <!-- Course code + title -->
                            <Label Text="{Binding DisplayTitle}"
                                   FontSize="18"
                                   FontAttributes="Bold" />

                            <!-- Room -->
                            <Label Text="{Binding Room}"
                                   FontSize="14"
                                   TextColor="Gray" />

                            <!-- Professor -->
                            <Label Text="{Binding Professor}"
                                   FontSize="14"
                                   TextColor="Gray" />

                            <!-- Days -->
                            <Label Text="{Binding Days}"
                                   FontSize="14"
                                   TextColor="Gray" />

                            <!-- Time range, e.g. 09:00-12:00 -->
                            <Label Text="{Binding DisplayTimeRange}"
                                   FontSize="14"
                                   TextColor="Gray" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Add Course Button -->
        <Button Grid.Row="3"
                x:Name="AddCourseButton"
                Text="+ Add Course"
                Clicked="OnAddCourseButtonClicked"
                BackgroundColor="#4A90E2"
                TextColor="White"
                FontSize="16"
                Padding="15"
                Margin="10"
                CornerRadius="8"
                HorizontalOptions="Center" />
    </Grid>

</ContentPage>