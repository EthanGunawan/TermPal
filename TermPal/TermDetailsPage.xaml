<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TermPal.TermDetailsPage"
             Title="Term Details">

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <!-- Term Title -->
        <Label Grid.Row="0"
               x:Name="TermTitleLabel"
               Text="Semester Title"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,20,0,10" />

        <!-- Courses Header -->
        <Label Grid.Row="1"
               Text="Courses"
               FontSize="18"
               FontAttributes="Bold"
               Margin="10,0,0,10" />

        <!-- Courses CollectionView -->
        <CollectionView Grid.Row="2"
                        x:Name="CoursesCollectionView"
                        ItemsSource="{Binding Courses}" />

        <!-- Add Course Button -->
        <Button Grid.Row="3"
                x:Name="AddCourseButton"
                Text="+ Add Course"
                Clicked="OnAddCourseButtonClicked"
                BackgroundColor="#4A90E2"
                TextColor="White"
                FontSize="16"
                Padding="15"
                Margin="10"
                CornerRadius="8"
                HorizontalOptions="Center" />
    </Grid>

</ContentPage>