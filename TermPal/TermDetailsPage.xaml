<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TermPal.TermDetailsPage"
             Title="Term Details">

    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <!-- Term Title -->
        <Label Grid.Row="0"
               x:Name="TermTitleLabel"
               Text="Semester Title"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               Margin="0,20,0,10" />

        <!-- New: date range label -->
        <Label Grid.Row="0"
               x:Name="TermDateRangeLabel"
               FontSize="14"
               TextColor="Gray"
               HorizontalOptions="Center"
               Margin="0,55,0,0" />

        <!-- Courses Header -->
        <Label Grid.Row="1"
               Text="Courses"
               FontSize="18"
               FontAttributes="Bold"
               Margin="10,0,0,10" />

        <!-- Courses CollectionView -->
        <CollectionView Grid.Row="2"
                        x:Name="CoursesCollectionView"
                        SelectionMode="Single"
                        SelectionChanged="CoursesCollectionView_SelectionChanged"
                        Margin="10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView>
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Delete"
                                           BackgroundColor="IndianRed"
                                           Invoked="OnDeleteCourseSwipeInvoked" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Margin="10"
                                Padding="15"
                                StrokeThickness="0"
                                BackgroundColor="#F5F5F5">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding DisplayTitle}"
                                       FontSize="18"
                                       FontAttributes="Bold" />
                                <Label Text="{Binding Room}"
                                       FontSize="14"
                                       TextColor="Gray" />
                                <Label Text="{Binding Professor}"
                                       FontSize="14"
                                       TextColor="Gray" />
                                <Label Text="{Binding Days}"
                                       FontSize="14"
                                       TextColor="Gray" />
                                <Label Text="{Binding DisplayTimeRange}"
                                       FontSize="14"
                                       TextColor="Gray" />
                            </VerticalStackLayout>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Add Course Button -->
        <Button Grid.Row="3"
                x:Name="AddCourseButton"
                Text="+ Add Course"
                Clicked="OnAddCourseButtonClicked"
                BackgroundColor="#4A90E2"
                TextColor="White"
                FontSize="16"
                Padding="15"
                Margin="10"
                CornerRadius="8"
                HorizontalOptions="Center" />
    </Grid>

</ContentPage>