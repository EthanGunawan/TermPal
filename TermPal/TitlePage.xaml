<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TermPal.TitlePage"
             BackgroundColor="White">

    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTappedAnywhere" />
        </Grid.GestureRecognizers>

        <VerticalStackLayout 
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="30"
            Padding="40">

            <!-- Welcome Title -->
            <Label 
                Text="Welcome to TermPal"
                FontSize="42"
                FontAttributes="Bold"
                TextColor="#4A90E2"
                HorizontalOptions="Center"
                LineBreakMode="WordWrap" />

            <!-- Subtitle -->
            <Label 
                Text="Organize your School's Time Tables like never before"
                FontSize="22"
                TextColor="#4A90E2"
                HorizontalOptions="Center"
                LineBreakMode="WordWrap" />

            <!-- Robot Image -->
            <Image
                Source="introbot.png"
                HeightRequest="160"
                WidthRequest="160"
                HorizontalOptions="Center"
                Margin="0,10,0,0" />

            <!-- Tap instruction -->
            <Label 
                Text="Tap anywhere to continue..."
                FontSize="18"
                TextColor="#4A90E2"
                FontAttributes="Italic"
                HorizontalOptions="Center"
                Margin="0,20,0,0" />

        </VerticalStackLayout>
    </Grid>

</ContentPage>